      ],
      "exactness": "Bind the delta-queue deadline representation and monotonic due predicate. The event-loop callback timestamp is not the AP when dispatch is late."
    },
    {
      "id": "BIND-ACK",
      "property_role": "cancel",
      "atomic_proposition": "coap_matching_ack_or_reset_received",
      "binding_kind": "POST_EXACT_OBJECT_REMOVAL",
      "primary_symbol": "coap_dispatch",
      "primary_locations": [
        "src/coap_net.c:4746-4749",
        "src/coap_net.c:4781-4789"
      ],
      "required_callee_locations": [
        "src/coap_net.c:3158-3203"
      ],
      "exactness": "ACK is true only when an ACK-arm removal yields the correlated node in sent; the OSCORE pre-decrypt removal is a conditional alternate."
    },
    {
      "id": "BIND-RST",
      "property_role": "cancel",
      "atomic_proposition": "coap_matching_ack_or_reset_received",
      "binding_kind": "POST_EXACT_OBJECT_REMOVAL",
      "primary_symbol": "coap_dispatch",
      "primary_locations": [
        "src/coap_net.c:4901-4903",
        "src/coap_net.c:4942-4945"
      ],
      "required_callee_locations": [
        "src/coap_net.c:3158-3203"
      ],
      "exactness": "RST is true only when the RST arm removes the correlated session+MID queue node."
    },
    {
      "id": "BIND-CANCEL-SESSION",
      "property_role": "cancel",
      "atomic_proposition": "coap_attempt_cancelled",
      "binding_kind": "POST_EXACT_OBJECT_REMOVAL",
      "primary_symbol": "coap_cancel_session_messages",
      "primary_locations": [
        "src/coap_net.c:3267-3303"
      ],
      "exactness": "Emit once for each removed queue-node generation, after unlink and before/at deletion; the function entry alone is not the event."
    },
    {
      "id": "BIND-CANCEL-TOKEN",
      "property_role": "cancel",
      "atomic_proposition": "coap_attempt_cancelled",
      "binding_kind": "POST_EXACT_OBJECT_REMOVAL",
      "primary_symbol": "coap_cancel_all_messages",
      "primary_locations": [
        "src/coap_net.c:3306-3335"
      ],
      "exactness": "Emit once per removed session/token-matching generation; a null token is the all-tokens branch."
    },
    {
      "id": "BIND-BOUND",
      "property_role": "bound",
