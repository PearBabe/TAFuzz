{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tafuzz.dev/rift/benchmark/m4/micro-input/1",
  "title": "RIFT-M4 answer-free synthetic analyzer input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_kind",
    "human_labels_required",
    "answer_access_policy",
    "private_oracle_commitment_sha256",
    "case_count",
    "ap_count",
    "global_compile_database",
    "production_schemas",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "rift.m4.micro-input.v1"},
    "corpus_kind": {"const": "SYNTHETIC_MECHANICAL_SOURCE_CORPUS"},
    "human_labels_required": {"const": false},
    "answer_access_policy": {"const": "PRE_ANALYSIS_SOURCE_AND_BUILD_METADATA_ONLY"},
    "private_oracle_commitment_sha256": {"$ref": "#/definitions/sha256"},
    "case_count": {"type": "integer", "minimum": 1},
    "ap_count": {"type": "integer", "minimum": 1},
    "global_compile_database": {"$ref": "#/definitions/artifact"},
    "production_schemas": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/definitions/production_schema"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/case"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "production_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_id", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z_]+\\.schema\\.json$"},
        "schema_id": {"type": "string", "pattern": "^https://tafuzz\\.dev/rift/schema/"},
        "path": {"type": "string", "pattern": "^src/StaticAnalysis/schema/"},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "language", "source", "compile_database", "property_ir", "ap_count"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^case_[0-9]{3}$"},
        "language": {"enum": ["c", "c++"]},
        "source": {"$ref": "#/definitions/artifact"},
        "compile_database": {"$ref": "#/definitions/artifact"},
        "property_ir": {"$ref": "#/definitions/artifact"},
        "ap_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
