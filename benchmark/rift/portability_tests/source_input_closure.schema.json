{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tafuzz.local/schema/rift-source-input-closure-v2.json",
  "title": "RIFT physical source-input closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "input_manifest_sha256", "entries"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_kind": {"const": "rift.source-input-closure"},
    "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_file_id", "logical_path", "physical_path", "role", "sha256",
          "byte_size"
        ],
        "properties": {
          "input_file_id": {"type": "string", "minLength": 1},
          "logical_path": {"type": "string", "pattern": "^riftpath://v1/"},
          "physical_path": {"type": "string", "minLength": 1},
          "role": {"enum": ["main", "user_header", "generated", "system", "toolchain"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
