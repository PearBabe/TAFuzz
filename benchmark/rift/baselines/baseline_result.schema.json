{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tafuzz.local/schemas/rift-baseline-result-v1.json",
  "title": "RIFT weak-baseline result matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyzer",
    "input_manifest_sha256",
    "analysis_status",
    "execution",
    "cases",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "rift.baseline-result.v1"
    },
    "analyzer": {
      "$ref": "#/definitions/analyzer"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "analysis_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNSUPPORTED",
        "ERROR"
      ]
    },
    "execution": {
      "$ref": "#/definitions/execution"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case_result"
      }
    },
    "limitations": {
      "$ref": "#/definitions/limitations"
    }
  },
  "definitions": {
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "implementation",
        "configuration",
        "command",
        "artifact_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "toolchain_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exit_code",
        "wall_seconds",
        "peak_rss_bytes",
        "toolchain",
        "analyzed_units"
      ],
      "properties": {
        "exit_code": {
          "type": "integer"
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak_rss_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "toolchain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/toolchain_component"
          }
        },
        "analyzed_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail",
        "locations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SOURCE",
            "AST",
            "LLVM",
            "SVF",
            "MODEL",
            "SUMMARY"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/location"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind",
        "certainty",
        "status",
        "evidence",
        "limitations"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "data",
            "control",
            "call",
            "return",
            "alias",
            "field",
            "parse",
            "state_commit",
            "timer",
            "callback",
            "enqueue",
            "dequeue",
            "setup",
            "timing",
            "event_order",
            "unknown"
          ]
        },
        "certainty": {
          "enum": [
            "MUST",
            "MAY",
            "MODELLED",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "CANDIDATE",
            "MODELLED",
            "UNRESOLVED"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "limitations": {
          "$ref": "#/definitions/limitations"
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "ap_id",
        "prediction",
        "status",
        "edges",
        "evidence",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^source_[a-z0-9_]+$"
        },
        "ap_id": {
          "type": "string",
          "pattern": "^ap_[a-z0-9_]+$"
        },
        "prediction": {
          "enum": [
            "MUST",
            "MAY",
            "NO",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "ANALYZED",
            "UNSUPPORTED",
            "ERROR"
          ]
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/edge"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "limitations": {
          "$ref": "#/definitions/limitations"
        }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "status",
        "predictions",
        "limitations"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^case_[0-9]{3}$"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNSUPPORTED",
            "ERROR"
          ]
        },
        "predictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/prediction"
          }
        },
        "limitations": {
          "$ref": "#/definitions/limitations"
        }
      }
    }
  }
}
