      "description_zh": "当前高度低于 RTL_ALT 时持续爬升，直到达到该高度。",
      "paper_formula_transcription": "G(((ALT_t < RTL_ALT) & (Mode_t = RTL)) -> (ALT_t-1 < ALT_t))",
      "binding_formula_interpretation": "G(((ALT_t < RTL_ALT) & (Mode_t = RTL)) -> (ALT_t-1 < ALT_t))",
      "inherits_from": null,
      "atomic_propositions": [
