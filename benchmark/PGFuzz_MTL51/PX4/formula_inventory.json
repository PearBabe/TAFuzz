        {
          "expression": "ALT_t >= RTL_RETURN_ALT",
          "role": "antecedent"
        },
        {
          "expression": "Pos_t != home_position",
          "role": "antecedent"
        },
        {
          "expression": "Pos_t-1 != Pos_t",
          "role": "consequent"
        },
        {
          "expression": "ALT_t-1 = ALT_t",
          "role": "consequent"
        }
