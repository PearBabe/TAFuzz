      "paper_formula_transcription": "G(((ALT_t < RTL_RETURN_ALT) & (Mode_t = RTL)) -> (ALT_t-1 < ALT_t))",
      "binding_formula_interpretation": "G(((ALT_t < RTL_RETURN_ALT) & (Mode_t = RTL)) -> (ALT_t-1 < ALT_t))",
      "inherits_from": null,
      "atomic_propositions": [
        {
          "expression": "ALT_t < RTL_RETURN_ALT",
          "role": "antecedent"
        },
        {
          "expression": "Mode_t = RTL",
          "role": "antecedent"
        },
        {
          "expression": "ALT_t-1 < ALT_t",
          "role": "consequent"
        }
      ],
      "issues": [
