{
  "schema_version": "2.0.0",
  "model_pack_id": "pack.platform.posix-lp64",
  "model_pack_version": "1.0.0",
  "layer": "platform",
  "property_independent": true,
  "target": {
    "target_version": "POSIX.1-2017",
    "target_abi": "linux-gnu-lp64",
    "evidence_id": "evidence.posix-public-api",
    "digest_policy": "freeze_before_property"
  },
  "resource_limits": {
    "max_selector_matches": 500000,
    "max_capture_values": 500000,
    "max_join_assignments": 500000,
    "max_emitted_facts": 500000
  },
  "selectors": [
    {
      "selector_id": "selector.posix.main",
      "kind": "exact_qualified_signature",
      "exact_value": "main:int (int, char **)",
      "application_private": false
    },
    {
      "selector_id": "selector.posix.read",
      "kind": "exact_qualified_signature",
      "exact_value": "read:long (int, void *, unsigned long)",
      "application_private": false
    },
    {
      "selector_id": "selector.posix.recv",
      "kind": "exact_qualified_signature",
      "exact_value": "recv:long (int, void *, unsigned long, int)",
      "application_private": false
    },
    {
      "selector_id": "selector.posix.recvfrom",
      "kind": "exact_qualified_signature",
      "exact_value": "recvfrom:long (int, void *, unsigned long, int, struct sockaddr *, unsigned int *)",
      "application_private": false
    },
    {
      "selector_id": "selector.posix.recvmsg",
      "kind": "exact_qualified_signature",
      "exact_value": "recvmsg:long (int, struct msghdr *, int)",
      "application_private": false
    },
    {
      "selector_id": "selector.posix.fread",
      "kind": "exact_qualified_signature",
      "exact_value": "fread:unsigned long (void *, unsigned long, unsigned long, struct _IO_FILE *)",
      "application_private": false
    },
    {
      "selector_id": "selector.posix.getenv",
      "kind": "exact_qualified_signature",
      "exact_value": "getenv:char *(const char *) noexcept",
      "application_private": false
    },
    {
      "selector_id": "selector.posix.clock-gettime",
      "kind": "exact_qualified_signature",
      "exact_value": "clock_gettime:int (int, struct timespec *)",
      "application_private": false
    }
  ],
  "rules": [
    {
      "rule_id": "rule.posix.argument-count",
      "matches": [
        {"match_id": "match.posix.main-count", "selector_ref": "selector.posix.main"}
      ],
      "captures": [
        {
          "capture_id": "capture.posix.argc",
          "match_ref": "match.posix.main-count",
          "projection": "formal_parameter",
          "index": 0
        }
      ],
      "joins": [],
      "emits": [
        {
          "emit_id": "emit.posix.argc",
          "fact_kind": "external_boundary",
          "source_capture_ref": "capture.posix.argc",
          "certainty": "modelled",
          "transfer_relation": "process_argument_count",
          "external_action": {
            "action_schema_id": "action.posix.argc",
            "action_class": "process_argument_count",
            "channel": "process_start",
            "operation": "set_argument_count",
            "payload_type": {"kind": "integer", "canonical": "int", "bit_width": 32, "signed": true},
            "payload_slot": "argc",
            "scope_schema": "process_epoch",
            "generation_schema": "process_epoch",
            "timing_capability": "startup_only",
            "required_capability": "environment"
          }
        }
      ],
      "evidence_note": "ISO C process entry receives an implementation-provided argument count."
    },
    {
      "rule_id": "rule.posix.process-arguments",
      "matches": [
        {"match_id": "match.posix.main", "selector_ref": "selector.posix.main"}
