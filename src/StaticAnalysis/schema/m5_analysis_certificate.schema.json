{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tafuzz.dev/rift/schema/m5-analysis-certificate/1.0.0",
  "title": "RIFT M5 detached-verifiable model/frontier/recipe certificate",
  "description": "Closed physical-provenance contract layered over an immutable M4 analysis certificate. Every path is an absolute path to bytes that a detached verifier can rehash; hashes reported inside semantic artifacts are never accepted as substitutes for these physical commitments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "certificate_id", "analysis_id", "status",
    "analyzer", "build_manifest", "m4_commitments", "model_packs",
    "executor_manifest", "runtime_components", "solver", "outputs",
    "stages", "invariants", "diagnostics", "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "certificate_id": {
      "type": "string",
      "pattern": "^m5-certificate:[0-9a-f]{64}$"
    },
    "analysis_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
    "status": {"enum": ["COMPLETE", "CONSERVATIVE_INCOMPLETE", "FAILED"]},
    "analyzer": {"$ref": "#/definitions/analyzer"},
    "build_manifest": {"$ref": "#/definitions/build_manifest"},
    "m4_commitments": {"$ref": "#/definitions/m4_commitments"},
    "model_packs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/model_pack"}
    },
    "executor_manifest": {
      "oneOf": [
        {"$ref": "#/definitions/executor_manifest"},
        {"type": "null"}
      ]
    },
    "runtime_components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/runtime_component"}
    },
    "solver": {"$ref": "#/definitions/solver"},
    "outputs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": [
        {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "model_fact_overlay"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "predicate_occurrence_bindings"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "frontier_candidates"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "fuzzable_frontier"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "mutation_recipes"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "recipe_replay_obligations"}}}
          ]
        }
      ],
      "additionalItems": false
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": [
        {
          "allOf": [
            {"$ref": "#/definitions/stage"},
            {"properties": {"stage_id": {"const": "stage.model"}, "name": {"const": "model"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/stage"},
            {"properties": {"stage_id": {"const": "stage.occurrence"}, "name": {"const": "occurrence"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/stage"},
            {"properties": {"stage_id": {"const": "stage.contextualize"}, "name": {"const": "contextualize"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/stage"},
            {"properties": {"stage_id": {"const": "stage.frontier"}, "name": {"const": "frontier"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/stage"},
            {"properties": {"stage_id": {"const": "stage.recipe"}, "name": {"const": "recipe"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/definitions/stage"},
            {"properties": {"stage_id": {"const": "stage.certificate"}, "name": {"const": "certificate"}}}
          ]
        }
      ],
      "additionalItems": false
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_vm_executed_before_property_load", "m4_cone_immutable",
        "ranking_never_prunes", "unknown_never_means_unsat",
        "unknown_candidates_retained", "unknown_recipe_emitted",
        "unsupported_or_timeout_preserved_as_unknown",
        "pack_cannot_assert_must", "executor_capability_independent"
      ],
      "properties": {
        "model_vm_executed_before_property_load": {"const": true},
        "m4_cone_immutable": {"const": true},
        "ranking_never_prunes": {"const": true},
        "unknown_never_means_unsat": {"const": true},
        "unknown_candidates_retained": {"const": true},
        "unknown_recipe_emitted": {"const": true},
        "unsupported_or_timeout_preserved_as_unknown": {"const": true},
        "pack_cannot_assert_must": {"const": true},
        "executor_capability_independent": {"const": true}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPLETE"}}},
      "then": {
        "properties": {
          "solver": {
            "properties": {
              "timeouts": {"const": 0},
              "unsupported": {"const": 0}
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "absolute_path": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "version", "binary_sha256", "binary_path",
        "runtime_component_id", "configuration_sha256"
      ],
      "properties": {
        "name": {"const": "tafuzz-sa"},
        "version": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/semver"},
        "binary_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "binary_path": {"$ref": "#/definitions/absolute_path"},
        "runtime_component_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "configuration_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
      }
    },
    "build_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_policy", "manifest_sha256", "production_core_sha256",
        "schema_bundle_sha256"
      ],
      "properties": {
        "identity_policy": {"const": "relative-path-and-content-v1"},
        "manifest_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "production_core_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "schema_bundle_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
      }
    },
    "physical_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "sha256", "path"],
      "properties": {
        "artifact_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "kind": {
          "enum": [
            "m4_analysis_certificate", "typed_property_ir", "semantic_index",
            "ap_bindings", "contextual_influence_graph", "ap_influence_cones",
            "model_fact_overlay", "predicate_occurrence_bindings",
            "frontier_candidates", "fuzzable_frontier",
            "mutation_recipes", "recipe_replay_obligations"
          ]
        },
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "path": {"$ref": "#/definitions/absolute_path"}
      }
    },
    "m4_commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_certificate", "typed_property_ir", "semantic_index",
        "ap_bindings", "contextual_influence_graph", "ap_influence_cones"
      ],
      "properties": {
        "analysis_certificate": {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "m4_analysis_certificate"}}}
          ]
        },
        "typed_property_ir": {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "typed_property_ir"}}}
          ]
        },
        "semantic_index": {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "semantic_index"}}}
          ]
        },
        "ap_bindings": {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "ap_bindings"}}}
          ]
        },
        "contextual_influence_graph": {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "contextual_influence_graph"}}}
          ]
        },
        "ap_influence_cones": {
          "allOf": [
            {"$ref": "#/definitions/physical_artifact"},
            {"properties": {"kind": {"const": "ap_influence_cones"}}}
          ]
        }
      }
    },
    "model_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_pack_id", "model_pack_version", "layer", "sha256",
        "semantic_sha256", "path"
      ],
      "properties": {
        "model_pack_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "model_pack_version": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/semver"},
        "layer": {"enum": ["platform", "framework", "project_adapter"]},
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "semantic_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "path": {"$ref": "#/definitions/absolute_path"}
      }
    },
    "executor_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_id", "executor_version", "artifact_id", "sha256", "path"
      ],
      "properties": {
        "executor_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "executor_version": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/semver"},
        "artifact_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "path": {"$ref": "#/definitions/absolute_path"}
      }
    },
    "runtime_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "name", "version", "component_kind", "sha256", "path"],
      "properties": {
        "component_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "name": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"},
        "version": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"},
        "component_kind": {"enum": ["executable", "shared_object", "data"]},
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "path": {"$ref": "#/definitions/absolute_path"}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "actual_version", "runtime_component_id",
        "component_sha256", "timeout_ms", "max_queries", "budget_sha256",
        "queries", "timeouts", "unsupported"
      ],
      "properties": {
        "name": {"const": "Z3"},
        "actual_version": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"},
        "runtime_component_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "component_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "max_queries": {"type": "integer", "minimum": 0},
        "budget_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "queries": {"type": "integer", "minimum": 0},
        "timeouts": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "name", "status", "input_sha256", "output_sha256", "diagnostics"],
      "properties": {
        "stage_id": {"enum": ["stage.model", "stage.occurrence", "stage.contextualize", "stage.frontier", "stage.recipe", "stage.certificate"]},
        "name": {"enum": ["model", "occurrence", "contextualize", "frontier", "recipe", "certificate"]},
        "status": {"enum": ["COMPLETE", "CONSERVATIVE_INCOMPLETE", "FAILED"]},
        "input_sha256": {
          "type": "array",
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
        },
        "output_sha256": {
          "type": "array",
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
        },
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"}
        }
      }
    }
  }
}
