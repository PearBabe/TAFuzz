{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tafuzz.dev/rift/schema/typed-property-ir/2.0.0",
  "title": "RIFT typed temporal property IR compatibility envelope",
  "oneOf": [
    {"$ref": "#/definitions/document_v1"},
    {"$ref": "#/definitions/document_v2"}
  ],
  "definitions": {
    "document_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artifact_id", "property_id", "logic", "time_domain",
        "formula_text", "formula", "atomic_propositions", "selectors"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "property_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "logic": {"enum": ["MITL", "MTL", "LTL"]},
        "time_domain": {"enum": ["dense", "discrete"]},
        "formula_text": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"},
        "formula": {"$ref": "#/definitions/formula_node"},
        "atomic_propositions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/atomic_proposition_v1"}
        },
        "selectors": {
          "type": "array",
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/selector"}
        },
        "source_document": {"$ref": "#/definitions/source_document"}
      }
    },
    "document_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "artifact_id", "property_id", "logic", "time_domain",
        "formula_text", "formula", "atomic_propositions", "selectors"
      ],
      "properties": {
        "schema_version": {"const": "2.0.0"},
        "artifact_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "property_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "logic": {"enum": ["MITL", "MTL", "LTL"]},
        "time_domain": {"enum": ["dense", "discrete"]},
        "formula_text": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"},
        "formula": {"$ref": "#/definitions/formula_node"},
        "atomic_propositions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/atomic_proposition_v2"}
        },
        "selectors": {
          "type": "array",
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/selector"}
        },
        "source_document": {"$ref": "#/definitions/source_document"}
      }
    },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "digest"],
      "properties": {
        "document_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "digest": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "requirement_location": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "lower_closed", "upper_closed", "unit"],
      "properties": {
        "lower": {"type": "number", "minimum": 0},
        "upper": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"const": "infinity"}
          ]
        },
        "lower_closed": {"type": "boolean"},
        "upper_closed": {"type": "boolean"},
        "unit": {"enum": ["ns", "us", "ms", "s", "min", "h", "tick"]},
        "bound_ap_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"}
        }
      }
    },
    "formula_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "operator", "operands"],
      "properties": {
        "node_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "operator": {
          "enum": [
            "atom", "not", "and", "or", "implies", "globally", "eventually",
            "until", "since", "next", "previous", "true", "false"
          ]
        },
        "ap_ref": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "interval": {"$ref": "#/definitions/interval"},
        "operands": {
          "type": "array",
          "items": {"$ref": "#/definitions/formula_node"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"operator": {"const": "atom"}}},
          "then": {"required": ["ap_ref"], "properties": {"operands": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"operator": {"enum": ["true", "false"]}}},
          "then": {"properties": {"operands": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"operator": {"enum": ["not", "globally", "eventually", "next", "previous"]}}},
          "then": {"properties": {"operands": {"minItems": 1, "maxItems": 1}}}
        },
        {
          "if": {"properties": {"operator": {"enum": ["implies", "until", "since"]}}},
          "then": {"properties": {"operands": {"minItems": 2, "maxItems": 2}}}
        },
        {
          "if": {"properties": {"operator": {"enum": ["and", "or"]}}},
          "then": {"properties": {"operands": {"minItems": 2}}}
        },
        {
          "if": {"properties": {"operator": {"enum": ["globally", "eventually", "until", "since"]}}},
          "then": {"required": ["interval"]}
        }
      ]
    },
    "atomic_proposition_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ap_id", "roles", "value_type", "predicate", "selector_refs"],
      "properties": {
        "ap_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/ap_role"}
        },
        "value_type": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/value_type"},
        "predicate": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/expression_structure"},
        "selector_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"}
        },
        "description": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"}
      }
    },
    "role_selector_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "role", "all_of"],
      "properties": {
        "group_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "role": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/ap_role"},
        "all_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"}
        }
      }
    },
    "atomic_proposition_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ap_id", "roles", "value_type", "predicate", "role_selector_groups"],
      "properties": {
        "ap_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/ap_role"}
        },
        "value_type": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/value_type"},
        "predicate": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/expression_structure"},
        "role_selector_groups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/role_selector_group"}
        },
        "description": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"}
      }
    }
  }
}
