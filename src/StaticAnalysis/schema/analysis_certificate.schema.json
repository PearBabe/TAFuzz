{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tafuzz.dev/rift/schema/analysis-certificate/2.0.0",
  "title": "RIFT reproducible analysis certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "certificate_id", "analysis_id", "status", "analyzer",
    "build_manifest", "core_tree_sha256", "schema_bundle_sha256", "environment",
    "inputs", "source_input_provenance", "toolchain", "outputs", "stages", "unsupported_constructs",
    "started_at", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "certificate_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
    "analysis_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
    "status": {"enum": ["COMPLETE", "CONSERVATIVE_INCOMPLETE", "FAILED"]},
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "version", "binary_sha256", "configuration_sha256",
        "environment_sha256"
      ],
      "properties": {
        "name": {"const": "tafuzz-sa"},
        "version": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/semver"},
        "binary_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "configuration_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "environment_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
      }
    },
    "build_manifest": {"$ref": "#/definitions/build_manifest"},
    "core_tree_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
    "schema_bundle_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
    "environment": {"$ref": "#/definitions/environment"},
    "inputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": [
        {"allOf": [
          {"$ref": "#/definitions/file_artifact_digest"},
          {"properties": {"kind": {"const": "typed_property_ir"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/file_artifact_digest"},
          {"properties": {"kind": {"const": "compile_commands"}}}
        ]},
        {"$ref": "#/definitions/source_inputs_digest"}
      ],
      "additionalItems": false
    },
    "source_input_provenance": {"$ref": "#/definitions/source_input_provenance"},
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/tool_component"}
    },
    "outputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": [
        {"allOf": [
          {"$ref": "#/definitions/file_artifact_digest"},
          {"properties": {"kind": {"const": "semantic_index"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/file_artifact_digest"},
          {"properties": {"kind": {"const": "ap_bindings"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/file_artifact_digest"},
          {"properties": {"kind": {"const": "contextual_influence_graph"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/file_artifact_digest"},
          {"properties": {"kind": {"const": "ap_influence_cones"}}}
        ]}
      ],
      "additionalItems": false
    },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": [
        {"allOf": [
          {"$ref": "#/definitions/stage"},
          {"properties": {"name": {"const": "index"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/stage"},
          {"properties": {"name": {"const": "bind"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/stage"},
          {"properties": {"name": {"const": "influence"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/stage"},
          {"properties": {"name": {"const": "cone"}}}
        ]},
        {"allOf": [
          {"$ref": "#/definitions/stage"},
          {"properties": {"name": {"const": "certificate"}}}
        ]}
      ],
      "additionalItems": false
    },
    "unsupported_constructs": {
      "type": "array",
      "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/unsupported_construct"}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPLETE"}}},
      "then": {
        "properties": {
          "unsupported_constructs": {"maxItems": 0},
          "stages": {
            "items": {"properties": {"status": {"const": "COMPLETE"}}}
          }
        }
      }
    }
  ],
  "definitions": {
    "build_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_policy", "manifest_sha256", "production_core_sha256",
        "schema_bundle_sha256"
      ],
      "properties": {
        "identity_policy": {"const": "relative-path-and-content-v1"},
        "manifest_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "production_core_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "schema_bundle_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "variables"],
      "properties": {
        "digest": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "variables": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {"$ref": "#/definitions/environment_variable"}
        }
      }
    },
    "environment_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "present", "value_sha256"],
      "properties": {
        "name": {
          "enum": [
            "CL", "COMPILER_PATH", "CPATH", "CPLUS_INCLUDE_PATH",
            "C_INCLUDE_PATH", "GCC_EXEC_PREFIX", "INCLUDE", "LANG",
            "LC_ALL", "LC_CTYPE", "MACOSX_DEPLOYMENT_TARGET",
            "OBJC_INCLUDE_PATH", "PATH", "SDKROOT", "SOURCE_DATE_EPOCH",
            "_CL_"
          ]
        },
        "present": {"type": "boolean"},
        "value_sha256": {
          "oneOf": [
            {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"present": {"const": true}}},
          "then": {"properties": {"value_sha256": {"type": "string"}}},
          "else": {"properties": {"value_sha256": {"type": "null"}}}
        }
      ]
    },
    "file_artifact_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "sha256", "path"],
      "properties": {
        "artifact_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "kind": {
          "enum": [
            "typed_property_ir", "compile_commands", "llvm_module",
            "semantic_index", "model_pack", "ap_bindings",
            "contextual_influence_graph", "ap_influence_cones", "other"
          ]
        },
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "path": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"}
      }
    },
    "source_inputs_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "kind": {"const": "source_inputs"},
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
      }
    },
    "source_input_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "files"],
      "properties": {
        "manifest_sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/source_input_file"}
        }
      }
    },
    "source_input_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_file_id", "logical_path", "role", "sha256", "byte_size",
        "observed_paths"
      ],
      "properties": {
        "input_file_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "logical_path": {"pattern": "^riftpath://v1/[a-z0-9][a-z0-9._-]*/.*$", "type": "string"},
        "role": {"enum": ["main", "user_header", "generated", "system", "toolchain"]},
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"},
        "byte_size": {"minimum": 0, "type": "integer"},
        "observed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"pattern": "^/", "type": "string"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"role": {"not": {"const": "toolchain"}}}},
          "then": {"properties": {"observed_paths": {"minItems": 1}}}
        }
      ]
    },
    "tool_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "name", "version", "component_kind", "sha256"],
      "properties": {
        "component_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "name": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"},
        "version": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/nonempty_string"},
        "component_kind": {"enum": ["executable", "shared_object", "data"]},
        "sha256": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_id", "name", "status", "input_sha256", "output_sha256", "diagnostics"],
      "properties": {
        "stage_id": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/stable_id"},
        "name": {"enum": ["index", "bind", "influence", "cone", "certificate"]},
        "status": {"enum": ["COMPLETE", "CONSERVATIVE_INCOMPLETE", "FAILED", "NOT_RUN"]},
        "input_sha256": {"type": "array", "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}},
        "output_sha256": {"type": "array", "items": {"$ref": "https://tafuzz.dev/rift/schema/common/1.0.0#/definitions/sha256"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
